{
  "偏航特性": {
    "数据集检索": "(scenario_object.meta.meta_DPDT.DPDT_Badcase.lv1 : \"DT导航特性\" and not (scenario_object.meta.meta_DPDT.DPDT_Badcase.lv2 : \"DT导航特性/小样本集\" or scenario_object.meta.meta_DPDT.DPDT_Badcase.lv2 : \"DT导航特性/0714ABCD实车BadCase\" or scenario_object.meta.meta_DPDT.DPDT_Badcase.lv2 : \"DT导航特性/SD_Feature\")) or scenario_object.meta.meta_PNCDEV.badcase_topics_Openloop.lv1 : \"导航\" or scenario_object.meta.meta_QA.open_loop_evalution_category : \"通用-偏航\" or scenario_object.meta.meta_HCTQA.problem_phenomenon : \"效率类-偏航\"",
    "primary_result": 0,
    "指标配置": [
      {
        "name": "偏航失败帧率",
        "agg": "sum",
        "numerator": "DirectionDeviMetricOP_EvalFailedFrame",
        "denominator": "DirectionDeviMetricOP_EvalTotalFrame",
        "value_format": "%",
        "rollback_threshold": "<1%",
        "optimize_threshold": "<-1%",
        "note": "越小越好"
      },
      {
        "name": "偏航失败帧差",
        "agg": "sum",
        "numerator": "DirectionDeviMetricOP_EvalFailedFrame",
        "denominator": null,
        "value_format": "int",
        "rollback_threshold": "<10",
        "optimize_threshold": "<-10",
        "note": "越小越好"
      }
    ],
    "小特性": {
      "enabled": true,
      "selector": "scenario_object.meta.meta_PNCDEV.badcase_topics_Openloop.lv2"
    }
  },
  "纵向特性": {
    "数据集检索": "scenario_object.meta.meta_PNCDEV.badcase_topics_Openloop.lv2 : \"纵向/CUTIN\" or scenario_object.meta.meta_QA.stable_dataset.lv1 : \"大规控-泛cutin\"",
    "primary_result": 0,
    "指标配置": [
      {
        "name": "平均风险score差",
