        "rollback_threshold": "<1%",
        "optimize_threshold": "<-1%",
        "note": "越小越好"
      },
      {
        "name": "平均多模态风险score差",
        "agg": "sum",
        "numerator": "CollisionRiskMetricOP_MultiTraj_takeover_average_score_Avg",
        "denominator": null,
        "value_format": "float",
        "rollback_threshold": "<1",
        "optimize_threshold": "<-1",
        "note": "越小越好"
      },
      {
        "name": "平均多模态dist差",
        "agg": "ave",
        "numerator": "YieldDistanceMetricOP_MultiTraj_AvgDist_Avg",
        "denominator": null,
        "value_format": "int",
        "rollback_threshold": "<0.5",
        "optimize_threshold": "<-0.5",
        "note": "越小越好"
      }
    ],
    "小特性": {
      "enabled": true,
      "selector": "scenario_object.meta.general.category.lv2"
    }
  },
  "横向特性": {
    "数据集检索": "scenario_object.meta.meta_DPDT.DPDT_Badcase.lv2 : \"DT-横向-badcase守护集/居中\" or scenario_object.meta.meta_DPDT.DPDT_Badcase.lv2 : \"DT横向-因果混淆/车道居中\" or scenario_object.meta.meta_DPDT.DPDT_Expert.lv2 : \"DT-横向/居中\" or scenario_object.meta.meta_HCTQA.problem_phenomenon : \"拟人类-不居中\"",
